# Copy to project root as .env:  cp config/.env.example .env
# Get keys at https://developer.ebay.com/my/keys
EBAY_ENV=sandbox                # sandbox | production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=                    # "RuName" (eBay Redirect URL name) from User Tokens page
EBAY_REFRESH_TOKEN=             # filled in by: python3 tools/auth_setup.py

# Business policies + location used for drafts (Seller Hub > Account > Business policies)
# Run: python3 tools/list_drafts.py --show-policies   to list your IDs
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_MERCHANT_LOCATION_KEY=     # created automatically by auth_setup.py --create-location if empty
